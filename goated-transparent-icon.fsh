#!/usr/bin/env bash

#	Author	: Nishikant Kanunje
#	Date	: 03/06/2026
#	Purpose	: Creates goated transparent icon file (ImageMagic did not work properly)

# Help
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    script_name="${BASH_SOURCE}"
    script_name="${script_name##*[/\\]}"

    cat <<EOF
Usage: ${script_name} [ARGUMENT...]
Creates a proper transparent icon for Microshaft Windows ME (Mistake Edition).
If no TARGET is provided, the icon will be created in the current directory.

  -h, --help        display this help and exit
  TARGET            directory path (e.g., /dir/path/) or explicit file path
                    (e.g., /dir/path/filename.ext)
EOF
    return 0 >/dev/null 2>&1 || exit 0
fi

# Fallback to current directory if no argument is provided
target_input="${1:-.}"

# Check if the input is an existing directory, or ends with a slash
if [ -d "$target_input" ] || [[ "$target_input" == */ ]]; then
    # It is a directory, so append the default filename
    target_path="${target_input%/}/goated_transparent.ico"
else
    # It is a file path
    target_path="$target_input"

    # Isolate the filename and check if it contains a dot
    if [[ "${target_path##*/}" != *.* ]]; then
        # No extension found, append .ico
        target_path="${target_path}.ico"
    fi
fi

# Extract folder and create it if it does not exist
dir_path=$(/usr/bin/dirname "$target_path")
[[ ! -d "$dir_path" ]] && /usr/bin/mkdir -p "$dir_path"

# Finally export base64 to magical (woooooo) icon file
printf '%s' "" | /usr/bin/base64 -d >"$target_path"
